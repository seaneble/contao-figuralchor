{% extends '@Contao/fe_page.html.twig' %}

{% block head %}
    {{ parent() }}
    <style>:root{--theme-hue:{{ figuralchor_theme_hue() }}}</style>
{% endblock %}

{% block header %}
    <header id="header">
        <div class="inside">
            <h1 class="site-branding">
                <a href="/">
                    <img
                        src="/files/theme/logo/Logo_Figuralchor_schwarz_mit_Schrift.svg"
                        alt="Figuralchor Stuttgart"
                        width="200" height="51"
                    >
                </a>
            </h1>
            {% if header %}
                {{ header|raw }}
            {% endif %}
        </div>
    </header>
{% endblock %}
