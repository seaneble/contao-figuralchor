{#
    Reader: full concert - title, year, poster, HTML description, and the
    linked tl_calendar_events dates ("the exact happenings"), each linking
    to that event's own details view.
#}
<div class="concert-full">
    <p class="concert-full__meta">{{ year }}</p>
    <h2>{{ title }}</h2>

    {% if addImage %}
        <div class="concert-full__poster">
            {{ include('@Contao/image.html.twig') }}
        </div>
    {% endif %}

    {% if hasDescription %}
        <div class="ce_text content-text block">
            {{ description|sanitize_html('contao')|csp_inline_styles|insert_tag_raw }}
        </div>
    {% elseif hasTeaser %}
        <p class="concert-full__teaser">{{ teaser|nl2br }}</p>
    {% endif %}

    {% if hasEvents %}
        <h3>{{ eventsHeadline }}</h3>
        <ul class="concert-full__events">
            {% for event in events %}
                <li>
                    {% if event.href %}
                        <a href="{{ event.href }}"><span class="date">{{ event.date }}</span> {{ event.title }}</a>
                    {% else %}
                        <span class="date">{{ event.date }}</span> {{ event.title }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
