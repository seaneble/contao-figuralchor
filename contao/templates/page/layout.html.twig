{% extends '@Contao/page/layout.html.twig' %}

{% block head %}
    {{ parent() }}
    <style>:root{--theme-hue:{{ figuralchor_theme_hue() }}}</style>
    <link rel="icon" href="/files/theme/favicon/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/files/theme/favicon/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/files/theme/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/files/theme/favicon/site.webmanifest">
    <meta name="theme-color" content="#000000">
{% endblock %}

{% block body_content %}
    {% slot header %}
        <header id="header">
            <h1 class="site-branding">
                <a href="/">
                    <img
                        src="/files/theme/logo/Logo_Figuralchor_weiss_mit_Schrift.svg"
                        alt="Figuralchor Stuttgart"
                        width="200" height="51"
                    >
                </a>
            </h1>
            {{ slot() }}
        </header>
    {% endslot %}

    {% slot main %}
        <main>{{ slot() }}</main>
    {% endslot %}

    {% slot footer %}
        <footer>{{ slot() }}</footer>
    {% endslot %}
{% endblock %}
