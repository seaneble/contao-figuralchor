{#
 # Override of the default main navigation template: mobile toggle via the
 # checkbox/label hack (a hidden checkbox + a <label for> styled as the
 # button, shown/hidden with a ~ sibling selector in CSS) - zero
 # JavaScript. Deliberately NOT <details>/<summary>: closed <details>
 # content is skipped by the browser's layout engine entirely, not just
 # hidden, and no CSS override (not display:flex!important, not explicit
 # width/height) can make it lay out normally while visually "closed" -
 # incompatible with this component also needing to become a normal,
 # always-visible static bar at wider viewports. Checkboxes/labels/divs
 # have none of that special-cased behavior.
 #
 # A second <label> acts as a full-page overlay (visible only while the
 # menu is open, see theme.css) so clicking anywhere outside the panel
 # closes it - same checkbox, same zero-JS mechanism.
 #}
{% set wrapperAttributes = attrs(cssID)
    .addClass([class, 'block'])
    .addStyle(style|default)
    .setIfExists('aria-label', ariaLabel|insert_tag)
    .mergeWith(wrapperAttributes|default)
%}

<!-- indexer::stop -->
<nav{{ wrapperAttributes }}>

    {% if headline %}
        <{{ hl }}>{{ headline|insert_tag_raw }}</{{ hl }}>
    {% endif %}

    <a href="{{ request }}#{{ skipId }}" class="invisible">{{ skipNavigation }}</a>

    <input type="checkbox" id="nav-toggle-{{ skipId }}" class="nav-toggle-checkbox invisible">
    <label for="nav-toggle-{{ skipId }}" class="nav-toggle__button">
        <span class="invisible">Menü ein-/ausblenden</span>
    </label>
    <label for="nav-toggle-{{ skipId }}" class="nav-toggle__overlay" aria-hidden="true"></label>
    <div class="nav-toggle">
        {{ items|raw }}
    </div>

    <span id="{{ skipId }}" class="invisible"></span>

</nav>
<!-- indexer::continue -->
