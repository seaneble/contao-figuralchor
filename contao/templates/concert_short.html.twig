{#
    "Konzerte" page item - deliberately plain, matching the existing
    article-teaser look (see contao/templates/mod_article.html.twig's
    "alias" block: plain h3 heading, teaser text, "Weiterlesen" link at the
    bottom) rather than a boxed card.
#}
<article class="concert-item">
    {% if addImage %}
        <div class="concert-item__poster">
            {{ include('@Contao/image.html.twig') }}
        </div>
    {% endif %}
    <div class="ce_text content-text block">
        <p class="concert-item__meta">{{ year }}</p>
        <h3>{{ title }}</h3>
        {% if hasTeaser %}
            <div class="teaser">
                <p>{{ teaser|nl2br }}</p>
                {% if hasLink %}
                    <p class="more"><a href="{{ href }}" title="{{ readMore }}">{{ more }} <span class="invisible">{{ title }}</span></a></p>
                {% endif %}
            </div>
        {% elseif hasLink %}
            <p class="more"><a href="{{ href }}" title="{{ readMore }}">{{ more }} <span class="invisible">{{ title }}</span></a></p>
        {% endif %}
    </div>
</article>
