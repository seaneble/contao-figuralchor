{#
    "Konzerte" page item - poster tile for the .concert-grid layout
    (mod_concertlist_grid.html.twig). The whole tile is one stretched link
    (.concert-tile__link, positioned over the entire tile) so poster +
    overlay are both clickable; title/teaser stay in the DOM at all times
    and are only visually revealed on hover/focus via CSS opacity, so
    screen readers get them regardless of hover state. Year isn't shown
    here - the grid's own year-stripe tiles carry that.
#}
<div class="concert-tile{% if not addImage %} concert-tile--no-image{% endif %}">
    {% if addImage %}
        <div class="concert-tile__poster">
            {{ include('@Contao/image.html.twig') }}
        </div>
    {% endif %}
    <div class="concert-tile__overlay">
        <p class="concert-tile__title">{{ title }}</p>
        {% if hasTeaser %}
            <p class="concert-tile__teaser">{{ teaser|nl2br }}</p>
        {% endif %}
    </div>
    {% if hasLink %}
        <a class="concert-tile__link" href="{{ href }}" title="{{ readMore }}">
            <span class="invisible">{{ more }} {{ title }}</span>
        </a>
    {% endif %}
</div>
