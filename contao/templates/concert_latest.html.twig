{#
    Homepage tile item: compact, no year, title links to the reader (via
    this module instance's jumpTo). Sits inside the .mod_concertlist card
    (see the "Homepage tiles" CSS).
#}
<div class="concert">
    <span class="title">
        {% if hasLink %}
            <a href="{{ href }}">{{ title }}</a>
        {% else %}
            {{ title }}
        {% endif %}
    </span>
    {% if hasTeaser %}
        <p class="teaser">{{ teaser|nl2br }}</p>
    {% endif %}
</div>
