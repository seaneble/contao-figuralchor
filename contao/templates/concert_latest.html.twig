{#
    Homepage tile item: plain text only, no per-item link - this is the
    "minus the sorting title link" variant of the concert list, replacing
    the old ce_table "Konzertarchiv" and its sortable column header link.
    Sits inside the .mod_concertlist card (see the "Homepage tiles" CSS).
#}
<div class="concert">
    <span class="year">{{ year }}</span>
    <span class="title">{{ title }}</span>
    {% if hasTeaser %}
        <p class="teaser">{{ teaser|nl2br }}</p>
    {% endif %}
</div>
